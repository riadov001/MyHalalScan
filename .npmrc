# ============================================================================
# EAS Build / CI: do NOT enforce frozen lockfile
# ============================================================================
# EAS Cloud and other CI environments set CI=true, which makes pnpm default to
# --frozen-lockfile. When the lockfile format version differs from the pnpm
# version used in the CI environment the install fails with ERR_PNPM_NO_LOCKFILE.
# Setting frozen-lockfile=false here overrides the CI default without disabling
# the lockfile entirely — pnpm still reads and updates it, it just doesn't abort
# when the format is "not compatible".
frozen-lockfile=false
